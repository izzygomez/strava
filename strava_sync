#!/bin/bash

# Strava Sync - Convenience script to sync Strava data to Google Sheets and Google Calendar
# This script runs both strava_to_pfitz_gsheet and strava_to_gcal in sequence

set -e  # Exit on any error

echo "🏃 Starting Strava sync..."
echo

echo "📊 Syncing Strava activities to Google Sheets (Pfitz training plan)..."
python -m scripts.strava_to_pfitz_gsheet

echo
echo "📅 Syncing Strava activities to Google Calendar..."
python -m scripts.strava_to_gcal

echo
echo "✅ Strava sync completed successfully!"
